// ~/.rootlogon.C for roothelper (@ROOTHELPER_PREFIX@), generated by the installation.
//
// Macros only need ROOT_INCLUDE_PATH to contain @ROOTHELPER_PREFIX@/@ROOTHELPER_INCLUDEDIR@ and
//   #include <roothelper/roothelper.h>
// which loads the libraries itself. Loading them here as well lets ACLiC (macro.C+) link
// compiled macros against them; it costs little at startup. Skipped when roothelper is gone.
{
  const char* header = "@ROOTHELPER_PREFIX@/@ROOTHELPER_INCLUDEDIR@/roothelper/cling_libraries.h";
  if (gSystem->AccessPathName(header) == kFALSE) {
    gROOT->ProcessLine(Form("#include \"%s\"", header));
  }
}
