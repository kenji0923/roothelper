<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Generated by the roothelper installation. Link it into ~/.config/fontconfig/conf.d/.
     Makes the URW base 35 substitutes that ghostscript uses (and ProcessPDF outlines)
     available, and uses them for the PDF base 14 families even when Helvetica, Times,
     Courier, Symbol or Zapf Dingbats are installed. -->
<fontconfig>
  <dir>@ROOTHELPER_FONT_DIR@</dir>
  <match target="pattern">
    <test name="family"><string>Helvetica</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Nimbus Sans</string></edit>
  </match>
  <match target="pattern">
    <test name="family"><string>Times</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Nimbus Roman</string></edit>
  </match>
  <match target="pattern">
    <test name="family"><string>Times-Roman</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Nimbus Roman</string></edit>
  </match>
  <match target="pattern">
    <test name="family"><string>Courier</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Nimbus Mono PS</string></edit>
  </match>
  <match target="pattern">
    <test name="family"><string>Symbol</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Standard Symbols PS</string></edit>
  </match>
  <match target="pattern">
    <test name="family"><string>ZapfDingbats</string></test>
    <edit name="family" mode="assign" binding="strong"><string>D050000L</string></edit>
  </match>
  <match target="pattern">
    <test name="family"><string>Zapf Dingbats</string></test>
    <edit name="family" mode="assign" binding="strong"><string>D050000L</string></edit>
  </match>
  <match target="pattern">
    <test name="family"><string>ITC Zapf Dingbats</string></test>
    <edit name="family" mode="assign" binding="strong"><string>D050000L</string></edit>
  </match>
</fontconfig>
